# Copy to .env (git-ignored) and fill in what you use. Never commit real secrets.

# --- LLM providers (any one path is enough) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=                 # Grok (xAI) — https://console.x.ai  (model grok-4, grok-3-mini)
GEMINI_API_KEY=              # Gemini (Google) — https://aistudio.google.com/app/apikey  (model gemini-flash-latest, gemini-2.0-flash)
GOOGLE_API_KEY=              # alias for GEMINI_API_KEY
LLM_PROVIDER=ollama          # openai | anthropic | xai | grok | gemini | google | ollama (optional override)
LLM_MODEL=llama3.1           # optional model override — e.g., gpt-4o-mini / claude-sonnet-4 / grok-4 / gemini-flash-latest
LLM_BASE_URL=                # optional, e.g. http://127.0.0.1:11434/v1 or https://api.x.ai/v1 or https://generativelanguage.googleapis.com/v1beta

# --- API service ---
# Commercial Royal-Sec deployments MUST set RTAI_API_TOKEN and RTAI_REQUIRE_AUTH=1 for fail-closed
# See services/api/server.py:381-404, EULA.md §2, SECURITY.md
RTAI_API_TOKEN=              # empty = dev-open (logs warning); commercial = set token
RTAI_REQUIRE_AUTH=0          # set 1 to fail-closed: refuse to start without RTAI_API_TOKEN
RTAI_RATE_LIMIT=60           # requests/minute per client IP (canonical: 60, see server.py:349)
RTAI_AUDIT_LOG=audit.log     # hash-chained log path (rtai_core/audit.py:31)
RTAI_ACTOR=                  # optional actor override for audit chain

# --- Authorization attestations (scripted runs only; interactive by default) ---
# Legacy dev: PHISHSIM_ATTESTED=1 / INJECTION_FUZZER_ATTESTED=1 / RECON_ATTESTED=1
# Production: set RTAI_ATTEST_KEY and compute HMAC hex(hmac-sha256(key,b"attested"))[:16]
# For API active recon header: X-RTAI-Authorized: yes (dev) or HMAC(RTAI_ATTEST_KEY,b"active-recon")[:16] (commercial)
#   e.g. python -c "import hmac,hashlib,os; print(hmac.new(os.environ['RTAI_ATTEST_KEY'].encode(),b'active-recon',hashlib.sha256).hexdigest()[:16])"
RTAI_ATTEST_KEY=             # HMAC key for attestation bypass (see PRIVACY.md, AUP.md §4)
PHISHSIM_ATTESTED=0           # 1 (legacy) or HMAC when RTAI_ATTEST_KEY set
INJECTION_FUZZER_ATTESTED=0   # same
RECON_ATTESTED=0              # for 01-ai-recon-agent --include-http active gate

# --- Military-grade hardening (v4.1.0) ---
RTAI_FIPS=0                  # 1 = FIPS 140-3 approved-only (military_fips.py), RTAI_FIPS_STRICT=1 for hard fail
RTAI_FIPS_STRICT=0
RTAI_AUDIT_WORM=0             # 1 = chattr +a + 600 perms (WORM, see audit.py:93-115)
RTAI_SIEM_URL=                # https://siem.example/api/audit  (SIEM forwarder, audit.py)
RTAI_HSM_REQUIRED=0           # 1 = fail-closed if Vault/TPM/HSM not found (military_hsm.py)
RTAI_SECRETS_FILE=             # JSON file 600 perms with {"RTAI_API_TOKEN":"...","RTAI_ATTEST_KEY":"..."}
VAULT_ADDR=                   # https://vault.example:8200
VAULT_TOKEN=
RTAI_HSM_SLOT=                # PKCS#11 slot
RTAI_HSM_PIN=
RTAI_HSM_LIB=/usr/lib/libsofthsm2.so
RTAI_MTLS=0                   # 1 = require mTLS (needs RTAI_TLS_CERT/KEY/CA)
RTAI_TLS_CERT=                # /certs/server.crt  (military_mtls.py)
RTAI_TLS_KEY=                 # /certs/server.key
RTAI_TLS_CA=                  # /certs/ca.crt
RTAI_SPIFFE_ID=               # spiffe://royal-sec/ns/api/svc
RTAI_TPM_ATTEST=0             # 1 = TPM PCR quote pre-flight (military_tpm.py)
RTAI_OPA_POLICY=              # ./policies  (OPA Rego bundle, military_opa.py)
RTAI_SCOPES=recon:read,recon:write,jobs:read,fuzz:execute  # OPA scopes for bearer

# --- Repo location for the unified CLI ---
RTAI_HOME=
