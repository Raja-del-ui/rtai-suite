# Copy to .env (git-ignored) and fill in what you use. Never commit real secrets.

# --- LLM providers (any one path is enough) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=ollama          # openai | anthropic | ollama (optional override)
LLM_MODEL=llama3.1           # optional model override
LLM_BASE_URL=                # optional, e.g. http://127.0.0.1:11434/v1

# --- API service ---
# Commercial Royal-Sec deployments MUST set RTAI_API_TOKEN and RTAI_REQUIRE_AUTH=1 for fail-closed
# See services/api/server.py:381-404, EULA.md §2, SECURITY.md
RTAI_API_TOKEN=              # empty = dev-open (logs warning); commercial = set token
RTAI_REQUIRE_AUTH=0          # set 1 to fail-closed: refuse to start without RTAI_API_TOKEN
RTAI_RATE_LIMIT=60           # requests/minute per client IP (canonical: 60, see server.py:349)
RTAI_AUDIT_LOG=audit.log     # hash-chained log path (rtai_core/audit.py:31)
RTAI_ACTOR=                  # optional actor override for audit chain

# --- Authorization attestations (scripted runs only; interactive by default) ---
# Legacy dev: PHISHSIM_ATTESTED=1 / INJECTION_FUZZER_ATTESTED=1 / RECON_ATTESTED=1
# Production: set RTAI_ATTEST_KEY and compute HMAC hex(hmac-sha256(key,b"attested"))[:16]
# For API active recon header: X-RTAI-Authorized: yes (dev) or HMAC(RTAI_ATTEST_KEY,b"active-recon")[:16] (commercial)
#   e.g. python -c "import hmac,hashlib,os; print(hmac.new(os.environ['RTAI_ATTEST_KEY'].encode(),b'active-recon',hashlib.sha256).hexdigest()[:16])"
RTAI_ATTEST_KEY=             # HMAC key for attestation bypass (see PRIVACY.md, AUP.md §4)
PHISHSIM_ATTESTED=0           # 1 (legacy) or HMAC when RTAI_ATTEST_KEY set
INJECTION_FUZZER_ATTESTED=0   # same
RECON_ATTESTED=0              # for 01-ai-recon-agent --include-http active gate

# --- Repo location for the unified CLI ---
RTAI_HOME=
